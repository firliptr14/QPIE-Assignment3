use "C:\Users\Win\OneDrive - Chulalongkorn University\Chula\junior2\Microecono\reproduce_project\raw_data.dta"


**************************************************
********** Rename Variables **********************
**************************************************

rename v1 AGE
rename v2 AGEQ
rename v4 EDUC
rename v5 ENOCENT
rename v6 ESOCENT
rename v9 LWKLYWGE
rename v10 MARRIED
rename v11 MIDATL
rename v12 MT
rename v13 NEWENG
rename v16 CENSUS
rename v17 SOB
rename v18 QOB
rename v19 RACE
rename v20 SMSA
rename v21 SOATL
rename v24 WNOCENT
rename v25 WSOCENT
rename v27 YOB


**************************************************
********** Standardize Year of Birth *************
**************************************************

replace YOB = YOB - 1900 if YOB >= 1900


**************************************************
********** YOB Dummies ***************************
**************************************************

foreach i of numlist 0/9 {
    gen YR`i' = 0
    replace YR`i' = 1 if YOB == 20+`i' | ///
                           YOB == 30+`i' | ///
                           YOB == 40+`i'
}


**************************************************
********** QOB Dummies ***************************
**************************************************

foreach i of numlist 1/4 {
    gen QTR`i' = 0
    replace QTR`i' = 1 if QOB == `i'
}


**************************************************
********** QOB × YOB Dummies *********************
**************************************************

foreach j of numlist 1/3 {
    foreach i of numlist 0/9 {
        gen QTR`j'YR`i' = QTR`j' * YR`i'
    }
}


**************************************************
********** Cohort Variables **********************
**************************************************

gen COHORT = 2029

replace COHORT = 3039 if YOB <= 39 & YOB >= 30
replace COHORT = 4049 if YOB <= 49 & YOB >= 40


**************************************************
********** Age Variables *************************
**************************************************

replace AGEQ = AGEQ - 1900 if CENSUS == 80

gen AGEQSQ = AGEQ * AGEQ


**************************************************
**************************************************
********** PANEL A: BORN IN 1920 *****************
**************************************************
**************************************************

display " "
display "============================================"
display "PANEL A: MEN BORN IN 1920"
display "============================================"


********** Log weekly wage **********

* (1) Mean log weekly wage: born in Q1
sum LWKLYWGE if QTR1 == 1 & YOB == 20

* (2) Mean log weekly wage: born in Q2-Q4
sum LWKLYWGE if QTR1 != 1 & YOB == 20

* (3) Difference: Q1 - Q2/Q3/Q4
reg LWKLYWGE QTR1 if YOB == 20


********** Education **********

* (4) Mean education: born in Q1
sum EDUC if QTR1 == 1 & YOB == 20

* (5) Mean education: born in Q2-Q4
sum EDUC if QTR1 != 1 & YOB == 20

* (6) Difference: Q1 - Q2/Q3/Q4
reg EDUC QTR1 if YOB == 20


********** Wald Estimate **********

* Estimate wage and education equations jointly
sureg ///
    (eq1: LWKLYWGE QTR1) ///
    (eq2: EDUC QTR1) ///
    if YOB == 20

* (7) Wald estimate:
* difference in log wage / difference in education
nlcom ratio: [eq1]_b[QTR1] / [eq2]_b[QTR1]


********** OLS Estimate **********

* (8) OLS return to education
reg LWKLYWGE EDUC if YOB == 20



