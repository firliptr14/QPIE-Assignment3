* -------------------------------
* Log weekly wage
* -------------------------------

sum LWKLYWGE if QTR1 == 1 & YOB == 20
scalar wage_q1_20 = r(mean)

sum LWKLYWGE if QTR1 == 0 & YOB == 20
scalar wage_q234_20 = r(mean)

reg LWKLYWGE QTR1 if YOB == 20
scalar wage_diff_20 = _b[QTR1]
scalar wage_se_20   = _se[QTR1]


* -------------------------------
* Education
* -------------------------------

sum EDUC if QTR1 == 1 & YOB == 20
