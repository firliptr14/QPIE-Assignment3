********** Log Weekly Wage **********

* (1) Mean log weekly wage: Q1
sum LWKLYWGE if QTR1 == 1 & YOB == 20

* (2) Mean log weekly wage: Q2-Q4
sum LWKLYWGE if QTR1 == 0 & YOB == 20

* (3) Difference: Q1 - Q2/Q3/Q4
reg LWKLYWGE QTR1 if YOB == 20


********** Education **********

* (4) Mean education: Q1
sum EDUC if QTR1 == 1 & YOB == 20

* (5) Mean education: Q2-Q4
sum EDUC if QTR1 == 0 & YOB == 20

* (6) Difference: Q1 - Q2/Q3/Q4
reg EDUC QTR1 if YOB == 20


********** Wald Estimate **********

sureg ///
    (eq1: LWKLYWGE QTR1) ///
    (eq2: EDUC QTR1) ///
    if YOB == 20

* (7) Wald estimate
nlcom ratio: ///
    [eq1]_b[QTR1] / [eq2]_b[QTR1]


********** OLS Estimate **********

* (8) OLS return to education
reg LWKLYWGE EDUC if YOB == 20



