sum EDUC if QTR1 == 0 & YOB == 20
scalar educ_q234_20 = r(mean)

reg EDUC QTR1 if YOB == 20
scalar educ_diff_20 = _b[QTR1]
scalar educ_se_20   = _se[QTR1]


* -------------------------------
* Wald estimate
* -------------------------------

sureg ///
    (wage: LWKLYWGE QTR1) ///
    (educ: EDUC QTR1) ///
    if YOB == 20

nlcom (wald20: [wage]_b[QTR1] / [educ]_b[QTR1])

scalar wald_20    = r(b)[1,1]
scalar wald_se_20 = sqrt(r(V)[1,1])


* -------------------------------
* OLS estimate
* -------------------------------

reg LWKLYWGE EDUC if YOB == 20

scalar ols_20    = _b[EDUC]
scalar ols_se_20 = _se[EDUC]



